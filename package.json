{
  "name": "clickbot",
  "version": "0.1.0",
  "description": "Browser automation bot for allocating drivers to trucks across two web apps",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "allocate": "node src/index.js allocate-drivers",
    "fyi": "node src/index.js fyi-notify",
    "depot": "node src/index.js depot-monitor",
    "dashboard": "node src/web/server.js",
    "explore": "node src/explore.js",
    "demo:server": "node demo/server.js",
    "demo": "node scripts/run-demo.mjs",
    "test": "node src/utils/driverName.test.js && node src/utils/depotMonitor.test.js",
    "verify:names": "node scripts/verifyDriverNames.js",
    "install-browsers": "playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.53.0"
  }
}
