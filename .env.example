# Optional: automate Lytx sign-in (otherwise the bot waits for you to log in manually)
LYTX_USERNAME=
LYTX_PASSWORD=

# Lytx Video Search / Vehicles account (Wake Trucks task — chrisa@hfr.co.za)
LYTX_VEHICLES_USERNAME=
LYTX_VEHICLES_PASSWORD=

# Optional: automate Webfleet sign-in
# Webfleet has THREE fields: account name, username, and password.
WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=

# Dashboard access control (recommended on the VPS).
# Leave both blank for open access (old behaviour).
# ADMIN_PASSWORD = full app (you)
# GUEST_PASSWORD = Tracking + Stale Cameras only (share this with someone else)
ADMIN_PASSWORD=
GUEST_PASSWORD=
# Optional extra signing secret for session cookies
SESSION_SECRET=
