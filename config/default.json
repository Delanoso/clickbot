{
  "headless": false,
  "slowMoMs": 100,
  "defaultDriverName": "Driver Unknown",
  "loop": {
    "enabled": true,
    "delayBetweenRunsMs": 2000,
    "maxRuns": 0
  },
  "apps": {
    "dispatch": {
      "url": "https://login.lytx.com",
      "login": {
        "enabled": true,
        "manual": true,
        "usernameEnv": "LYTX_USERNAME",
        "passwordEnv": "LYTX_PASSWORD",
        "usernameSelector": "#username",
        "passwordSelector": "#password",
        "submitSelector": "#submit-button",
        "rememberMeSelector": "#remember-me-input",
        "successUrlPattern": "^(?!.*login\\.lytx\\.com).+",
        "timeoutMs": 300000
      },
      "selectors": {
        "truckNumber": "",
        "driverNameInput": "",
        "submitButton": "",
        "nextItemButton": ""
      }
    },
    "fleet": {
      "url": "https://example.com/fleet",
      "selectors": {
        "searchInput": "",
        "searchButton": "",
        "driverNameResult": "",
        "resultReady": ""
      }
    }
  },
  "validation": {
    "minNameLength": 2,
    "invalidNames": ["", "n/a", "na", "null", "undefined", "-", "--"]
  }
}
