{
  "headless": false,
  "slowMoMs": 150,
  "defaultDriverName": "Driver Unknown",
  "loop": {
    "enabled": true,
    "delayBetweenRunsMs": 2000,
    "maxRuns": 0
  },
  "apps": {
    "dispatch": {
      "url": "https://login.lytx.com",
      "login": {
        "enabled": true,
        "manual": true,
        "usernameEnv": "LYTX_USERNAME",
        "passwordEnv": "LYTX_PASSWORD",
        "usernameSelector": "#username",
        "passwordSelector": "#password",
        "submitSelector": "#submit-button",
        "rememberMeSelector": "#remember-me-input",
        "successUrlPattern": "^(?!.*login\\.lytx\\.com).+",
        "timeoutMs": 300000
      },
      "selectors": {
        "truckNumber": "",
        "driverNameInput": "",
        "submitButton": "",
        "nextItemButton": ""
      }
    },
    "fleet": {
      "url": "https://www.webfleet.com/webfleet/products/login/?application=webfleet",
      "login": {
        "enabled": true,
        "manual": true,
        "accountEnv": "WEBFLEET_ACCOUNT",
        "usernameEnv": "WEBFLEET_USERNAME",
        "passwordEnv": "WEBFLEET_PASSWORD",
        "accountSelector": "#accountname",
        "usernameSelector": "#useraccount",
        "passwordSelector": "#password",
        "submitSelector": "#submit_btn",
        "rememberMeSelector": "#rememberMe",
        "cookieAcceptSelector": "#wi-CookieConsent_Accept",
        "successUrlPattern": "live-wf\\.webfleet\\.com",
        "timeoutMs": 300000
      },
      "selectors": {
        "searchInput": "",
        "searchButton": "",
        "driverNameResult": "",
        "resultReady": ""
      }
    }
  }
}
