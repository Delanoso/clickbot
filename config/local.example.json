{
  "headless": false,
  "slowMoMs": 150,
  "defaultDriverName": "Driver Unknown",
  "loop": {
    "enabled": true,
    "delayBetweenRunsMs": 2000,
    "maxRuns": 0
  },
  "apps": {
    "dispatch": {
      "url": "https://login.lytx.com",
      "workUrl": "https://app.lytx.com/#/driver-safety/tasks/assigndriver",
      "login": {
        "enabled": true,
        "manual": true,
        "usernameEnv": "LYTX_USERNAME",
        "passwordEnv": "LYTX_PASSWORD",
        "usernameSelector": "#username",
        "passwordSelector": "#password",
        "submitSelector": "#submit-button",
        "rememberMeSelector": "#remember-me-input",
        "successUrlPattern": "app\\.lytx\\.com|^(?!.*login\\.lytx\\.com).+",
        "timeoutMs": 300000
      },
      "selectors": {
        "pageReady": { "text": "ASSIGN DRIVERS" },
        "firstVehicleCell": "table tbody tr:first-child td:nth-child(3)",
        "vehicleColumnIndex": 2,
        "vehicleSearchType": null,
        "vehicleSearchTypeOption": { "text": "Vehicle" },
        "vehicleSearchInput": { "placeholder": "Search Vehicle Name" },
        "vehicleSearchButton": null,
        "clearVehicleSearch": null,
        "selectAllCheckbox": "table thead input[type='checkbox']",
        "assignSelectedButton": { "role": "button", "name": "Assign Selected" },
        "rowAssignButton": { "role": "button", "name": "Assign", "exact": true },
        "driverNameInput": { "placeholder": "Search Name or ID" },
        "assignConfirmButton": { "role": "button", "name": "Assign", "exact": true }
      }
    },
    "fleet": {
      "url": "https://www.webfleet.com/webfleet/products/login/?application=webfleet",
      "workUrl": "https://live-wf.webfleet.com/web/map",
      "login": {
        "enabled": true,
        "manual": true,
        "accountEnv": "WEBFLEET_ACCOUNT",
        "usernameEnv": "WEBFLEET_USERNAME",
        "passwordEnv": "WEBFLEET_PASSWORD",
        "accountSelector": "#accountname",
        "usernameSelector": "#useraccount",
        "passwordSelector": "#password",
        "submitSelector": "#submit_btn",
        "rememberMeSelector": "#rememberMe",
        "cookieAcceptSelector": "#wi-CookieConsent_Accept",
        "successUrlPattern": "live-wf\\.webfleet\\.com",
        "timeoutMs": 300000
      },
      "selectors": {
        "vehiclesTab": { "text": "VEHICLES" },
        "searchInput": { "placeholder": "Search" },
        "resultItem": null,
        "driverNameResult": null
      }
    }
  }
}
